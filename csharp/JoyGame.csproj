<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mono 宿主加载：netstandard2.0 是最稳的目标框架 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>JoyGame</AssemblyName>
    <RootNamespace>JoyGame</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- 自动生成的绑定声明（勿手改） -->
    <Compile Include="Joy\InternalCalls.cs" Link="Joy\InternalCalls.cs" />
    <!-- 手写绑定声明 + 游戏业务 -->
    <Compile Include="game\**\*.cs" />
  </ItemGroup>
</Project>
